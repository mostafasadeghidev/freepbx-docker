# ---------------------------------------------------------------------------
# TEMPLATE — copy it to `.env` before the first run:
#
#     cp .env.example .env        (or just run ./setup.sh, which writes it)
#
# This file answers the questions that differ from one installation to the
# next: how big it is, where the panel is reachable, and whether there is a
# tunnel. Nothing here is a secret today, and `.env` is git-ignored so nothing
# here becomes one tomorrow.
#
# Everything the *installer inside the container* needs lives in `pbx.env`.
# Two files, because they are read at two different times: this one by docker
# compose while it builds the container, that one by FreePBX after it starts.
# ---------------------------------------------------------------------------

# --- which software ---------------------------------------------------------

# Where the image comes from.
#
# `freepbx17-official:local` means "build it here" — the first run downloads
# several GB and takes 20-40 minutes, once, on this machine. That is the
# default because it needs nothing from anybody: no registry, no account, no
# trust in an image somebody else built.
#
# Point it at a registry instead to skip that wait when you have one:
#
#     PBX_IMAGE=ghcr.io/you/freepbx17:17.0-3
#
# ⚠️ If you ever DO pull a ready-installed image, read the note about data
#    folders in the README first. An empty folder mounted over an installed
#    one hides it, and FreePBX comes up with nothing.
PBX_IMAGE=freepbx17-official:local

# --- how big ----------------------------------------------------------------

# How many extensions this PBX serves. It decides one thing: how many UDP
# ports are published for audio.
#
# Two ports per call. The usual FreePBX default is 10000-20000 — ten thousand
# ports — which Docker will not publish at any sensible speed, and which is
# why most FreePBX-in-Docker recipes fall back to host networking and then
# collide with everything else on the machine. You do not need ten thousand.
#
#     extensions   RTP_END      simultaneous calls
#     ----------   ----------   ------------------
#     up to 20     10039        20
#     up to 50     10099        50
#     up to 100    10199        100
#
# Whatever you set here must ALSO be set in FreePBX itself:
#   Settings → Asterisk SIP Settings → RTP Port Ranges.
# `./doctor.sh` checks that the two agree.
RTP_START=10000
RTP_END=10039

# --- how the panel is reached ----------------------------------------------

# Where the web panel is published on the host.
#
#   127.0.0.1   only from the server itself — the right answer when a proxy
#               (Caddy, Nginx, Traefik, Coolify's own) puts it on a domain
#               with HTTPS. This is the default, and it is the safe one.
#   0.0.0.0     straight onto the internet on PANEL_PORT, with no HTTPS and
#               no certificate. Only for a first look on a test machine.
PANEL_BIND=127.0.0.1
PANEL_PORT=8088

# --- SIP --------------------------------------------------------------------

# The port phones and the provider register to. 5060 is the standard one.
# Change it only if something else on this machine already has it.
SIP_PORT=5060

# --- optional pieces --------------------------------------------------------

# Which extra services start with the stack. Leave it empty for a plain PBX.
#
#   tunnel   an OpenVPN client, for a PBX abroad whose provider will only
#            talk to an address inside the country. See tunnel/README.md.
#            Most installations do not need this.
#
# Example: COMPOSE_PROFILES=tunnel
COMPOSE_PROFILES=
