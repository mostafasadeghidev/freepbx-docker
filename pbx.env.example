# ---------------------------------------------------------------------------
# TEMPLATE. Copy it before the first run and edit the copy:
#
#     cp pbx.env.example pbx.env
#
# `pbx.env` is git-ignored. Nothing secret belongs in this file — but an .env
# is where secrets end up sooner or later, so the real one never leaves the
# machine it runs on.
#
# Read both by docker compose (container environment) and by the
# freepbx-bootstrap systemd unit inside the container.
# ---------------------------------------------------------------------------

# The installer aborts unless `hostname -f` returns something, and a container
# hostname rarely has a domain part. bootstrap.sh adds
# "<hostname>.<PBX_DOMAIN>" to /etc/hosts when it does not resolve.
PBX_DOMAIN=local

TZ=Asia/Tehran

# Asterisk major version the installer builds. 22 is the FreePBX 17 default.
ASTVERSION=22

# Extra flags for sng_freepbx_debian_install.sh. Useful ones:
#   --opensourceonly   skip all commercial/Sangoma modules
#   --testing          use the FreePBX testing repository
#   --nochrony         skip chrony (auto-detected in containers anyway)
#   --dahdi            DAHDI/analog card support (needs host kernel modules)
#   --debianmirror URL alternative Debian mirror
#   --npmmirror URL    alternative npm registry
INSTALL_ARGS=

# Override to pin a specific installer revision instead of master.
#INSTALLER_URL=https://raw.githubusercontent.com/FreePBX/sng_freepbx_debian_install/master/sng_freepbx_debian_install.sh
