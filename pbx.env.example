# ---------------------------------------------------------------------------
# TEMPLATE. Copy it before the first run and edit the copy:
#
#     cp pbx.env.example pbx.env
#
# `pbx.env` is git-ignored. Nothing secret belongs in this file — but an .env
# is where secrets end up sooner or later, so the real one never leaves the
# machine it runs on.
#
# Read both by docker compose (container environment) and by the
# freepbx-bootstrap systemd unit inside the container.
# ---------------------------------------------------------------------------

# The installer aborts unless `hostname -f` returns something, and a container
# hostname rarely has a domain part. bootstrap.sh adds
# "<hostname>.<PBX_DOMAIN>" to /etc/hosts when it does not resolve.
PBX_DOMAIN=local

TZ=Asia/Tehran

# Asterisk major version the installer builds. 22 is the FreePBX 17 default.
ASTVERSION=22

# Extra flags for sng_freepbx_debian_install.sh.
#
# ⚠️ --opensourceonly is BROKEN as of installer v1.15 (measured 2026-09-08).
#    It skips installing the commercial modules and then tries to remove them
#    anyway: `xargs -I {} fwconsole ma -f remove {}` fails for every module
#    that was never installed, xargs exits 123, and the script's `set -e`
#    kills the install at line 1293 — after everything already works. The log
#    said "not installed" 116 times.
#    Leave INSTALL_ARGS empty. The commercial modules are installed but
#    unlicensed and unused; they cost disk, not behaviour.
#
# Other flags:
#   --testing          use the FreePBX testing repository
#   --nochrony         skip chrony (auto-detected in containers anyway)
#   --dahdi            DAHDI/analog card support (needs host kernel modules)
#   --debianmirror URL alternative Debian mirror
#   --npmmirror URL    alternative npm registry
INSTALL_ARGS=

# Override to pin a specific installer revision instead of master.
#INSTALLER_URL=https://raw.githubusercontent.com/FreePBX/sng_freepbx_debian_install/master/sng_freepbx_debian_install.sh

# The FreePBX firewall module. `off` (the default) disables it after install
# and on every later boot.
#
# It is the right tool on a bare metal PBX and the wrong one in a container,
# where Docker also owns rules in the same network namespace. Measured harm,
# both on a live system: it wiped Docker's DNS rule so Asterisk could not
# resolve its own trunk hostname, and its rate limiter silently DROPped a
# legitimate softphone after a few minutes of normal use -- self-renewing, so
# retrying kept it banned.
#
# fail2ban is separate, unaffected, and stays on. It bans repeated auth
# failures, which is the attack that actually matters on an internet-facing
# SIP port.
#
# Set to `on` only if you want the module's zone control and SIP rate limiting
# and are ready for both behaviours above. See README.
PBX_FIREWALL=off
